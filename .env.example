# ============================================================
#  Modele de configuration (SANS secrets) - celui-ci PEUT etre committe.
#  Copie ce fichier en ".env" et remplis les vraies valeurs.
#      copy .env.example .env      (PowerShell / Windows)
# ============================================================

# Cle API Bedrock (page "Generate short-term API key" de la console).
AWS_BEARER_TOKEN_BEDROCK=

# Region AWS (celle du modele Bedrock ET du log group CloudWatch).
AWS_REGION=eu-west-1
